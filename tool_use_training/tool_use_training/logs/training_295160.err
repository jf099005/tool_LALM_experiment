{"type": "function", "function": {"name": "clipping", "description": "Extract a WAV audio segment from a source file between specified HH:MM:SS.mmm begin and end timestamps.", "parameters": {"type": "object", "properties": {"audio_begin": {"type": "string", "format": "HH:MM:SS.mmm"}, "audio_end": {"type": "string", "format": "HH:MM:SS.mmm"}, "audio_id": {"type": "string", "description": "Id of an audio you've already seen (an input audio, or an id the harness assigned to an earlier call's output). If omitted, defaults to whichever audio your previous turn most recently produced (or the sole input audio, on your first turn)."}}, "required": ["audio_begin", "audio_end"]}}}
{"type": "function", "function": {"name": "denoise", "description": "Apply noise reduction or echo cancellation to a WAV audio file using the chosen algorithm. Requires audio_id and algorithm; optional noise_factor and sensitivity control processing.", "parameters": {"type": "object", "properties": {"algorithm": {"type": "string", "enum": ["spectral_subtraction", "wiener", "echo_cancellation", "adaptive"]}, "noise_factor": {"type": "number"}, "sensitivity": {"type": "number"}, "audio_id": {"type": "string", "description": "Id of an audio you've already seen (an input audio, or an id the harness assigned to an earlier call's output). If omitted, defaults to whichever audio your previous turn most recently produced (or the sole input audio, on your first turn)."}}, "required": ["algorithm"]}}}
{"type": "function", "function": {"name": "pitch_shift", "description": "Shift the pitch of an audio file (WAV or MP3) by a number of semitones without changing its duration, using librosa. Requires audio_id and n_steps (semitones; positive shifts up, negative shifts down).", "parameters": {"type": "object", "properties": {"n_steps": {"type": "number", "description": "Number of semitones to shift. Positive values shift up, negative values shift down."}, "bins_per_octave": {"type": "integer", "description": "Number of steps per octave (default 12)."}, "audio_id": {"type": "string", "description": "Id of an audio you've already seen (an input audio, or an id the harness assigned to an earlier call's output). If omitted, defaults to whichever audio your previous turn most recently produced (or the sole input audio, on your first turn)."}}, "required": ["n_steps"]}}}
{"type": "function", "function": {"name": "pre_emphasis", "description": "Apply a pre-emphasis filter to a WAV audio segment to boost high-frequency content and improve spectral balance. Requires audio_id and HH:MM:SS.mmm timestamps for audio_begin and audio_end.", "parameters": {"type": "object", "properties": {"audio_begin": {"type": "string", "format": "HH:MM:SS.mmm"}, "audio_end": {"type": "string", "format": "HH:MM:SS.mmm"}, "coef": {"type": "number"}, "audio_id": {"type": "string", "description": "Id of an audio you've already seen (an input audio, or an id the harness assigned to an earlier call's output). If omitted, defaults to whichever audio your previous turn most recently produced (or the sole input audio, on your first turn)."}}, "required": ["audio_begin", "audio_end"]}}}
{"type": "function", "function": {"name": "time_stretch", "description": "Time-stretch an audio file (WAV or MP3) by a fixed rate without changing its pitch, using librosa. Requires audio_id and rate (rate > 1 speeds up/shortens, rate < 1 slows down/lengthens).", "parameters": {"type": "object", "properties": {"rate": {"type": "number", "description": "Stretch factor. Values > 1 speed up (shorten); values < 1 slow down (lengthen)."}, "audio_id": {"type": "string", "description": "Id of an audio you've already seen (an input audio, or an id the harness assigned to an earlier call's output). If omitted, defaults to whichever audio your previous turn most recently produced (or the sole input audio, on your first turn)."}}, "required": ["rate"]}}}
{"type": "function", "function": {"name": "trim_silence", "description": "Trim silence from the beginning and end of a WAV audio segment. Requires audio_id and HH:MM:SS.mmm timestamps for audio_begin and audio_end.", "parameters": {"type": "object", "properties": {"audio_begin": {"type": "string", "format": "HH:MM:SS.mmm"}, "audio_end": {"type": "string", "format": "HH:MM:SS.mmm"}, "threshold_db": {"type": "number"}, "frame_length": {"type": "integer"}, "hop_length": {"type": "integer"}, "audio_id": {"type": "string", "description": "Id of an audio you've already seen (an input audio, or an id the harness assigned to an earlier call's output). If omitted, defaults to whichever audio your previous turn most recently produced (or the sole input audio, on your first turn)."}}, "required": ["audio_begin", "audio_end"]}}}
